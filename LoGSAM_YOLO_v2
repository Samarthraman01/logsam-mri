le() else \"cpu\")\nprint(f\"Device: {device}\")\n\n# Paths to BRISC dataset\nDATASET_ROOT = \"/kaggle/input/datasets/briscdataset/brisc2025/brisc2025\"\nTRAIN_IMAGES = f\"{DATASET_ROOT}/segmentation_task/train/images\"\nTRAIN_MASKS = f\"{DATASET_ROOT}/segmentation_task/train/masks\"\nTEST_IMAGES = f\"{DATASET_ROOT}/segmentation_task/test/images\"\nTEST_MASKS = f\"{DATASET_ROOT}/segmentation_task/test/masks\"\n\n# MedSAM checkpoint\nMEDSAM_CHECKPOINT = \"/kaggle/input/datasets/parmisdvrpnh/medsam/medsam_vit_b.pth\"\n\nprint(\"✅ Setup complete\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-23T12:02:41.980426Z","iopub.execute_input":"2026-09-23T12:02:41.980854Z","iopub.status.idle":"2026-09-23T12:02:42.607206Z","shell.execute_reply.started":"2026-09-23T12:02:41.98082Z","shell.execute_reply":"2026-09-23T12:02:42.606511Z"}},"outputs":[{"name":"stdout","text":"Creating new Ultralytics Settings v0.0.8 file ✅ \nView Ultralytics Settings with 'yolo settings' or at '/root/.config/Ultralytics/settings.json'\nUpdate Settings with 'yolo settings key=value', i.e. 'yolo settings runs_dir=path/to/dir'. For help see https://docs.ultralytics.com/usage/settings.\nDevice: cuda\n✅ Setup complete\n","output_type":"stream"}],"execution_count":3},{"cell_type":"markdown","source":"Data loader","metadata":{}},{"cell_type":"code","source":"# Cell 2: Prepare BRISC data in YOLO format\n\nimport os\nimport shutil\nfrom pathlib import Path\n\n# ── Create YOLO dataset directories ───────────────────────────────────────────\nYOLO_DATA_DIR = \"/kaggle/working/yolo_brisc\"\n\n# Remove old directory if exists\nif os.path.exists(YOLO_DATA_DIR):\n    shutil.rmtree(YOLO_DATA_DIR)\n\n# Create new directories\nos.makedirs(f\"{YOLO_DATA_DIR}/images/train\", exist_ok=True)\nos.makedirs(f\"{YOLO_DATA_DIR}/images/val\", exist_ok=True)\nos.makedirs(f\"{YOLO_DATA_DIR}/labels/train\", exist_ok=True)\nos.makedirs(f\"{YOLO_DATA_DIR}/labels/val\", exist_ok=True)\n\nprint(\"✅ YOLO directories created\")\n\n# ── Helper function: Convert bounding box to YOLO format ─────────────────────\ndef pixel_box_to_yolo(pixel_box, img_width=512, img_height=512):\n    \"\"\"\n    Convert pixel box [x_min, y_min, x_max, y_max] to YOLO format\n    Returns: [center_x, center_y, width, height] normalized 0-1\n    \"\"\"\n    x_min, y_min, x_max, y_max = pixel_box\n    \n    # Calculate center and dimensions\n    center_x = (x_min + x_max) / 2.0\n    center_y = (y_min + y_max) / 2.0\n    width = x_max - x_min\n    height = y_max - y_min\n    \n    # Normalize to 0-1 range\n    center_x /= img_width\n    center_y /= img_height\n    width /= img_width\n    height /= img_height\n    \n    return [center_x, center_y, width, height]\n\n# Test the conversion\ntest_box = [100, 100, 300, 300]\nyolo_box = pixel_box_to_yolo(test_box)\nprint(f\"Test conversion: {test_box} → {yolo_box}\")\n\nprint(\"✅ Helper function ready\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-23T12:21:36.393352Z","iopub.execute_input":"2026-09-23T12:21:36.393835Z","iopub.status.idle":"2026-09-23T12:21:36.403667Z","shell.execute_reply.started":"2026-09-23T12:21:36.393804Z","shell.execute_reply":"2026-09-23T12:21:36.402799Z"}},"outputs":[{"name":"stdout","text":"✅ YOLO directories created\nTest conversion: [100, 100, 300, 300] → [0.390625, 0.390625, 0.390625, 0.390625]\n✅ Helper function ready\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# Cell 3: Load BRISC, extract boxes, convert to YOLO format\n\nfrom PIL import Image\nimport numpy as np\nfrom sklearn.model_selection import train_test_split\n\n# ── Map tumor class codes to class IDs for YOLO ──────────────────────────────\nCLASS_MAP = {\n    \"gl\": 0,  # glioma = class 0\n    \"me\": 1,  # meningioma = class 1\n    \"pi\": 2,  # pituitary = class 2\n}\n\n# ── Helper: Load binary mask ──────────────────────────────────────────────────\ndef load_binary_mask(mask_path):\n    \"\"\"\n    Load PNG mask, threshold at 127 to get binary (0 or 1)\n    \"\"\"\n    mask = np.array(Image.open(mask_path).convert(\"L\"))\n    return (mask > 127).astype(np.uint8)\n\n# ── Helper: Extract bounding box from mask ────────────────────────────────────\ndef mask_to_bbox(binary_mask):\n    \"\"\"\n    Extract bounding box from binary mask\n    Returns: [x_min, y_min, x_max, y_max] or None if no mask\n    \"\"\"\n    rows = np.any(binary_mask > 0, axis=1)\n    cols = np.any(binary_mask > 0, axis=0)\n    \n    if not rows.any():\n        return None\n    \n    y_min, y_max = np.where(rows)[0][[0, -1]]\n    x_min, x_max = np.where(cols)[0][[0, -1]]\n    \n    return [int(x_min), int(y_min), int(x_max), int(y_max)]\n\n# ── Load all BRISC training data ──────────────────────────────────────────────\nprint(\"Loading BRISC data...\")\n\nall_records = []\n\nfor filename in sorted(os.listdir(TRAIN_IMAGES)):\n    if not filename.endswith(\".jpg\"):\n        continue\n    \n    # Extract class from filename (position 3: \"brisc2025_test_00013_gl_ax_t1.jpg\")\n    parts = filename.split(\"_\")\n    class_code = parts[3]  # \"gl\", \"me\", \"pi\", \"no\"\n    \n    # Skip healthy (class \"no\") and unmapped classes\n    if class_code not in CLASS_MAP:\n        continue\n    \n    class_id = CLASS_MAP[class_code]\n    \n    # Load mask and extract box\n    mask_path = os.path.join(TRAIN_MASKS, filename.replace(\".jpg\", \".png\"))\n    if not os.path.exists(mask_path):\n        continue\n    \n    bbox = mask_to_bbox(load_binary_mask(mask_path))\n    if bbox is None:\n        continue\n    \n    all_records.append({\n        \"image_filename\": filename,\n        \"image_path\": os.path.join(TRAIN_IMAGES, filename),\n        \"mask_path\": mask_path,\n        \"class_id\": class_id,\n        \"bbox\": bbox,\n    })\n\nprint(f\"✅ Loaded {len(all_records)} valid records\")\n\n# ── Split into train (80%) and val (20%) ──────────────────────────────────────\ntrain_records, val_records = train_test_split(\n    all_records, test_size=0.2, random_state=42\n)\n\nprint(f\"Train: {len(train_records)}, Val: {len(val_records)}\")\n\n# ── Write to YOLO directory structure ─────────────────────────────────────────\nprint(\"\\nWriting to YOLO format...\")\n\ndef write_yolo_dataset(records, split_name):\n    \"\"\"\n    Write records to YOLO directory (train or val)\n    \"\"\"\n    count = 0\n    for record in records:\n        # Copy image\n        img_filename = record[\"image_filename\"]\n        src_img = record[\"image_path\"]\n        dst_img = f\"{YOLO_DATA_DIR}/images/{split_name}/{img_filename}\"\n        shutil.copy(src_img, dst_img)\n        \n        # Convert box to YOLO format and write label\n        yolo_box = pixel_box_to_yolo(record[\"bbox\"])\n        class_id = record[\"class_id\"]\n        \n        # Create label file (same name, .txt extension)\n        label_filename = img_filename.replace(\".jpg\", \".txt\")\n        label_path = f\"{YOLO_DATA_DIR}/labels/{split_name}/{label_filename}\"\n        \n        with open(label_path, \"w\") as f:\n            # Format: class_id center_x center_y width height\n            f.write(f\"{class_id} {yolo_box[0]:.6f} {yolo_box[1]:.6f} {yolo_box[2]:.6f} {yolo_box[3]:.6f}\\n\")\n        \n        count += 1\n    \n    return count\n\ntrain_count = write_yolo_dataset(train_records, \"train\")\nval_count = write_yolo_dataset(val_records, \"val\")\n\nprint(f\"✅ Wrote {train_count} train images + labels\")\nprint(f\"✅ Wrote {val_count} val images + labels\")\n\n# ── Create data.yaml (YOLO configuration file) ────────────────────────────────\nyaml_content = f\"\"\"path: {YOLO_DATA_DIR}\ntrain: images/train\nval: images/val\n\nnc: 3\nnames: ['glioma', 'meningioma', 'pituitary']\n\"\"\"\n\nwith open(f\"{YOLO_DATA_DIR}/data.yaml\", \"w\") as f:\n    f.write(yaml_content)\n\nprint(f\"\\n✅ Created data.yaml\")\nprint(f\"\\nYOLO dataset ready at: {YOLO_DATA_DIR}\")","metadata":{"trusted":true,"execution":{"iopub.status